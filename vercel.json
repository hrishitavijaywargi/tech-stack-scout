{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/refresh?source=vercel-weekly", "schedule": "0 6 * * 1" },
    { "path": "/api/cron/refresh?source=vercel-daily", "schedule": "0 7 * * *" }
  ]
}
