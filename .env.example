# ---------------------------------------------------------------
# Tech Stack Scout — environment variables
# Copy to .env.local for local development; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------

# Supabase (Project Settings → API). SUPABASE_URL is also accepted as an alias.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable/anon key. Not used by the browser today (all reads/writes are server-side) — listed for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_… or legacy service_role JWT). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub token (fine-grained or classic, public read access only). Needed for GraphQL and 5,000 req/h.
GITHUB_TOKEN=

# Gemini (https://aistudio.google.com/apikey). All AI tasks use Gemini Flash via @google/genai.
GEMINI_API_KEY=
# Model ids are configurable. Primary + fallback are both stable Gemini Flash models.
GEMINI_MODEL=gemini-3.6-flash
# Used when the primary is overloaded or out of quota (and first for web research, to spread free-tier quota).
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Gemini + Google Search grounding step (1 extra Gemini request per company). true/false.
WEB_RESEARCH_ENABLED=true

# Protects /api/cron/refresh. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically;
# the Supabase pg_cron job sends the same header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Password gate for the whole app (httpOnly session cookie). Leave blank to disable.
APP_PASSWORD=
