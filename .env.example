# ---------------------------------------------------------------
# Tech Stack Scout — environment variables
# Copy to .env.local for local development; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only secret key (sb_secret_… or legacy service_role JWT). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_… or legacy anon). Not required by the app today — the
# browser never talks to Supabase directly — listed for completeness.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini (https://aistudio.google.com/apikey). All AI tasks use Gemini Flash.
GEMINI_API_KEY=
# Model ids are configurable. Primary = stable Flash model with the larger free-tier quota.
GEMINI_MODEL=gemini-3.6-flash
# Used only if the primary Flash model is overloaded (HTTP 429/5xx) after retries.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# GitHub token (fine-grained, "Public repositories (read-only)", no extra permissions).
# Optional but strongly recommended: raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Shared secret for the scheduler. Vercel Cron sends it automatically as
# "Authorization: Bearer $CRON_SECRET"; the Supabase pg_cron job sends the same header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: protect the whole UI with HTTP Basic Auth (leave blank to disable).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
